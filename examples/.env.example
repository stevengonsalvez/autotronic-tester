# API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_API_KEY=sk-your-openai-api-key-here  # Alternative to OPENAI_API_KEY

# Browser Settings
BROWSER_HEADLESS=false  # Set to 'true' to run browser in headless mode
BROWSER_COOKIES_FILE=./examples/cookies/cookies.json  # Path to your cookies file

# Test Settings
SCREENSHOT_DIR=./screenshots  # Directory to save screenshots 