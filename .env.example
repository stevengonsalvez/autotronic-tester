# LLM Configuration
# Available providers: openai, anthropic, azure
LLM_PROVIDER=openai

# API Keys (uncomment and set the one you need)
# LLM_API_KEY=sk-xxx                  # For OpenAI
# LLM_API_KEY=sk-ant-xxx             # For Anthropic
# LLM_API_KEY=azure-key-xxx          # For Azure

# Model Configuration
# OpenAI models: gpt-4, gpt-3.5-turbo, etc.
# Anthropic models: claude-2, claude-instant-1, etc.
# Azure: your-deployment-name
LLM_MODEL=gpt-4

# Optional Configuration
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT=600

# Playwright Configuration
SCREENSHOTS_DIR=screenshots
DEFAULT_TIMEOUT=30000
BROWSER_HEADLESS=false 

# Agent Behavior Configuration
# Controls whether to use group chat mode with multiple agents
USE_GROUP_CHAT=true

# Controls how the web_tester agent operates:
# - auto: Let the LLM decide whether to use tools or generate code (default)
# - code_generation: Force the agent to always generate complete Python code
# - tool_usage: Force the agent to always use tools directly
FORCE_MODE=auto

# Code Execution Configuration
# Timeout for code execution in seconds
EXECUTION_TIMEOUT=300

# LLM Caching Configuration
# Enable/disable LLM response caching
LLM_CACHE_ENABLE=true
# Cache location
LLM_CACHE_PATH=/tmp/autogen-playwright-cache
# Optional seed for reproducible results
# LLM_CACHE_SEED=42 
